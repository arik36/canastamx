# CanastaMX — variables del despliegue en la VM (T054 · #201)
#
# En la VM, desde la raíz del repositorio:
#
#   cp infra/envs/prod/.env.example infra/envs/prod/.env
#
# y completa los valores vacíos. El .env vive SÓLO en la VM: nunca se sube al
# repositorio (está en .gitignore) ni se manda por chat. Para revisarlo sin
# mostrar valores:
#   python3 infra/scripts/revisar-env.py infra/envs/prod/.env
#
# FORMATO: CLAVE=valor, sin comillas, sin «export», sin espacios alrededor del
# «=» y sin comentarios al final de la línea. Ninguna contraseña con «$»: Docker
# Compose lo lee como una variable. Cómo generar cada una: infra/envs/prod/README.md.

# --- La dirección pública y el certificado ---
# DIRECCION_PUBLICA: el nombre que apunta a la IP de la VM, sin https:// ni barra
# final. La web queda en él; el dominio en dominio.<nombre> y la interfaz analítica
# en analitica.<nombre>.
DIRECCION_PUBLICA=
# ACME_CORREO: a dónde escribe Let's Encrypt si el certificado está por vencer.
ACME_CORREO=
# ACME_SERVIDOR: vacío es el servidor de producción de Let's Encrypt. Para ensayar
# sin gastar su límite semanal, el de pruebas (su certificado no es de confianza):
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_SERVIDOR=

# --- PostgreSQL transaccional (servicio de dominio) ---
OLTP_DB=canastamx_oltp
OLTP_USER=canastamx
OLTP_PASSWORD=

# --- PostgreSQL analítico (plataforma de datos e interfaz analítica) ---
ANALYTICS_DB=canastamx_analytics
ANALYTICS_USER=canastamx
ANALYTICS_PASSWORD=

# --- MinIO · la capa cruda ---
# S3_ACCESS_KEY: mínimo 3 caracteres. S3_SECRET_KEY: mínimo 8.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=canastamx-bronze

# --- Servicio de dominio ---
# JWT_SECRET: Base64 de 32 bytes aleatorios (ADR 020): openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- Cuentas semilla (ANALISTA y OPERADOR) ---
# Mínimo 8 caracteres, una mayúscula y un número. La usa
# infra/scripts/sembrar-cuentas.sh --prod; nunca se imprime.
SEMILLA_CONTRASENA=

# --- Plataforma de datos ---
# CARPETA_DE_LOTES: ruta absoluta de la carpeta de la VM donde se copian los
# lotes, fuera del repositorio. Por ejemplo /home/ubuntu/canastamx-lotes
CARPETA_DE_LOTES=
# Dagster sólo escucha en 127.0.0.1 de la VM; se entra con un túnel SSH.
DAGSTER_PUERTO=3000
