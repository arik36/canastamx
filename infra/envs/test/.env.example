# CanastaMX-Test — variables de entorno - Entorno de Pruebas
#
# Copia este archivo como .env y completa los valores vacíos.
# El .env NUNCA se sube al repositorio: está en .gitignore.
#
#   cp .env.example .env
#
# Los valores que ya vienen llenos son nombres y puertos, no secretos:
# déjalos como están salvo que un puerto ya esté ocupado en tu máquina.
# Los que están vacíos son los que tú inventas.
#
# REGLA: toda variable nueva se agrega aquí, con el valor vacío, en el mismo
# commit donde se empieza a usar. Si no, el sistema levanta en tu máquina y
# en la de nadie más.

# --- PostgreSQL transaccional (servicio de dominio · C1) ---
OLTP_DB=test-canastamx_oltp
OLTP_USER=canastamx
OLTP_PASSWORD=
OLTP_PORT=5442

# --- PostgreSQL analitico (capas silver, gold, cuarentena · A) ---
ANALYTICS_DB=test-canastamx_analytics
ANALYTICS_USER=canastamx
ANALYTICS_PASSWORD=
ANALYTICS_PORT=5443

# --- Almacenamiento de objetos · capa bronze (A) ---
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=canastamx-bronze-test
S3_PORT=9010
S3_CONSOLE_PORT=9011

# El guion de ingesta corre en TU maquina, no dentro de compose.
# Dentro de la red de compose el nombre seria http://minio:9010
S3_ENDPOINT=http://localhost:9010

# --- Servicio de dominio (C1 · desde la semana 7) ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- Fuentes externas (A) ---
INEGI_API_TOKEN=
PROFECO_QQP_URL=
