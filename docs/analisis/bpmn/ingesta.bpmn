      <bpmndi:BPMNShape id="Nota_H1_di" bpmnElement="Nota_H1"><dc:Bounds x="1170" y="392" width="260" height="56" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Nota_H1_a_di" bpmnElement="Nota_H1_a"><di:waypoint x="1310" y="365" /><di:waypoint x="1310" y="392" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
