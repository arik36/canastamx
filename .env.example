# CanastaMX — variables de entorno
#
# Copia este archivo como .env y completa los valores vacíos.
# El .env NUNCA se sube al repositorio: está en .gitignore.
#
#   cp .env.example .env
#
# Los valores que ya vienen llenos son nombres y puertos, no secretos:
# déjalos como están salvo que un puerto ya esté ocupado en tu máquina.
# Los que están vacíos son los que tú inventas.
#
# REGLA: toda variable nueva se agrega aquí, con el valor vacío, en el mismo
# commit donde se empieza a usar. Si no, el sistema levanta en tu máquina y
# en la de nadie más.

# --- PostgreSQL transaccional (servicio de dominio · C1) ---
OLTP_DB=canastamx_oltp
OLTP_USER=canastamx
OLTP_PASSWORD=
OLTP_PORT=5432

# --- PostgreSQL analitico (capas silver, gold, cuarentena · A) ---
ANALYTICS_DB=canastamx_analytics
ANALYTICS_USER=canastamx
ANALYTICS_PASSWORD=
ANALYTICS_PORT=5433

# --- MinIO (capa bronze · A) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=canastamx-bronze
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Adminer (cliente web de base de datos) ---
# Cambia el puerto si el 8080 ya lo usa otra cosa en tu maquina.
ADMINER_PORT=8080

# --- Servicio de dominio (C1 · desde la semana 7) ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- Fuentes externas (A) ---
INEGI_API_TOKEN=
PROFECO_QQP_URL=
