# Cópialo como .env.local. La web lo lee en el servidor; el navegador nunca lo ve.
# DOMINIO_URL: dónde corre el servicio de dominio. Vacía, usa http://localhost:8081.
# Para trabajar sin el dominio, con el simulador del contrato:
#   npx @stoplight/prism-cli mock ../../docs/analisis/openapi/dominio.yaml -p 4010
# y DOMINIO_URL=http://127.0.0.1:4010
DOMINIO_URL=
